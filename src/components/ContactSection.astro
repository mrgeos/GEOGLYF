---
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
interface Props { title?: string; lead?: string }
const {
  title = 'Каждый сильный бренд начинается <em>с одного сообщения</em>',
  lead = 'Напишите пару слов о задаче. Отвечу в течение рабочего дня, предложу формат и вилку стоимости.',
} = Astro.props;
---
<section class="band" id="contact">
  <div class="band__inner">
    <div class="band__lime">
      <h2 class="band__title" set:html={title}></h2>
      <p class="band__lead">{lead}</p>
      <img src={url('/assets/shape-star.png')} alt="" width="676" height="658" loading="lazy" class="band__shape float" aria-hidden="true">
    </div>
    <div class="band__form">
      <ContactForm />
      <div class="band__messengers">
        <p>Или напишите напрямую</p>
        <a class="msg msg--tg" href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener" aria-label="Telegram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
        <a class="msg msg--phone" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </div>
</section>
