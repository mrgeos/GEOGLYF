---
const clients = ['МТС', 'PepsiCo', 'Mars', 'Леруа Мерлен', 'Минприроды России', 'Правительство Москвы', 'Мултон', 'Движение ЭКА', 'ПосадиЛес', 'Эковики', 'Экокласс', 'Сеть кинотеатров КАРО', 'Формула Кино', 'Чайхона №1', 'Рестораны Урюк', 'Академия русского балета им. Вагановой', 'ГК ФСК', 'Парк Минный Городок', '6sense'];
---
<section class="clients" aria-label="Клиенты">
  <p class="clients__title">Работал с лидерами и стартапами</p>
  <div class="marquee" data-marquee>
    <ul class="marquee__track">
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>
