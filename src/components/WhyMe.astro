---
interface Props { title?: string }
const { title = 'Почему я, <em>а не агентство?</em>' } = Astro.props;
const points = [
  { n: '01', h: 'держу слово', t: 'Работаю по договору, не исчезаю, не срываю сроки и не обещаю того, чего не сделаю. Каждый этап закрывается актом, по пятницам вы знаете, что произошло за неделю.' },
  { n: '02', h: 'мне важен ваш результат', t: 'Не рисую «красиво» ради красивого. Погружаюсь в нишу и аудиторию, смотрю, что побуждает клиента нажать кнопку, и строю дизайн вокруг этого.' },
  { n: '03', h: 'со мной просто', t: 'Вы общаетесь напрямую с арт-директором, а не с менеджером. Объясняю без жаргона, показываю варианты, не устраиваю творческий хаос.' },
];
---
<section class="why-me">
  <h2 class="h2" set:html={title}></h2>
  <div class="why-me__grid">
    {points.map((p) => (
      <article class="why-me__item">
        <span class="why-me__n">/{p.n}/</span>
        <h3 class="why-me__h">{p.h}</h3>
        <p>{p.t}</p>
      </article>
    ))}
  </div>
</section>
