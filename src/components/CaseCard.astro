---
import type { Case } from '../data/cases';
import { url } from '../lib/url';
interface Props { item: Case; wide?: boolean }
const { item, wide = false } = Astro.props;
---
<a class:list={['case', { 'case--wide': wide }]} href={url(`/work/${item.slug}/`)}>
  <span class="case__media">
    <img src={item.cover} alt={`Обложка проекта ${item.name}`} width="1200" height="1200" loading="lazy">
  </span>
  <span class="case__name">{item.name}</span>
  <span class="case__type">{item.type}</span>
  <span class="case__chips">{item.services.map((s) => <span class="chip chip--sm">{s.toLowerCase()}</span>)}</span>
</a>
