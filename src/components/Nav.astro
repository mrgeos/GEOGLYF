---
import { site } from '../data/site';
import { url } from '../lib/url';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---
<header class="nav" id="top">
  <a class="logo" href={url('/')} aria-label="GEOGLYF, на главную">
    <span class="logo__word">GEOGLYF</span>
    <span class="logo__sub">digital design<br>&amp; branding</span>
    <span class="logo__by">by Georgy Schustow</span>
  </a>
  <nav class="nav__links" aria-label="Разделы">
    {site.nav.map((l) => (
      <a href={url(l.href)} class:list={{ 'is-active': isActive(l.href) }} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="nav__phone">
    <a href={site.phoneHref}>{site.phone}</a>
    <a href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener">Telegram @{site.telegram}</a>
  </div>
  <a class="btn btn--accent nav__cta" href={url(site.cta.href)}>{site.cta.label}</a>
  <button class="burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mm__cols">
    <nav class="mm__main" aria-label="Меню">
      <a href={url('/support/')}>Дизайн-поддержка</a>
      <a href={url('/services/branding/')}>Брендинг</a>
      <a href={url('/services/websites/')}>Сайты и лендинги</a>
      <a href={url('/services/ui-ux/')}>UI/UX дизайн</a>
      <a href={url('/services/key-visual/')}>Key visual</a>
      <a href={url('/work/')}>Проекты</a>
      <a href={url('/contacts/')}>Контакты</a>
    </nav>
    <nav class="mm__side" aria-label="Дополнительно">
      <a href={url('/services/')}>Все услуги</a>
      <a href={url('/services/')}>Стоимость</a>
      <a href={url('/services/presentations/')}>Презентации</a>
      <a href={url('/services/audit/')}>Консультация</a>
      <a href={url('/about/')}>Обо мне</a>
      <a href={site.archive} target="_blank" rel="noopener">Архив работ</a>
    </nav>
  </div>
  <div class="mm__bottom">
    <a class="btn btn--accent btn--block" href={url(site.cta.href)}>{site.cta.label}</a>
    <div class="mm__phone">
      <a href={site.phoneHref}>{site.phone}</a>
      <span>отвечаю в рабочие часы</span>
    </div>
    <div class="mm__msg">
      <p>Или напишите<br>в мессенджер</p>
      <a class="msg--tg" href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener" aria-label="Telegram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </a>
    </div>
  </div>
</div>
