---
import Base from '../layouts/Base.astro';
import Clients from '../components/Clients.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactSection from '../components/ContactSection.astro';
import Timeline from '../components/Timeline.astro';
import { cases } from '../data/cases';
import { site } from '../data/site';
import {
  heroBadges, stats, objections, participation, priceGroups,
  contractorCards, mindset, claims, timeline,
} from '../data/home';
import { url } from '../lib/url';

const br = (s: string) => s.replace(/\n/g, ' <br>');
---
<Base
  title="GEOGLYF. Гео Шустов. Дизайн-поддержка бизнеса и проектный дизайн"
  description="Мультидисциплинарный дизайнер и арт-директор Георгий Шустов. Дизайн-поддержка по Time & Material, брендинг, айдентика, сайты, лендинги, UI/UX и key visual. 20 лет в индустрии, 650+ проектов.">

  <!-- Hero: brand-colour flood with a giant wordmark -->
  <section class="flood">
    <div class="flood__inner">
      <div class="flood__top">
        <div class="flood__text">
          <h1 class="flood__title">Дизайнер<br>полного цикла</h1>
          <p class="flood__lead">Веду дизайн бренда каждую неделю или делаю проект под ключ: айдентика, сайт, интерфейс, key visual.</p>
          <div class="flood__actions">
            <a class="btn btn--dark btn--block" href={url(site.cta.href)}>{site.cta.label}</a>
            <a class="btn btn--outline btn--block" href="#prices">Цены на услуги</a>
          </div>
        </div>
        <div class="flood__badges">
          {heroBadges.map((b) => (
            <div class="badge">
              <p class="badge__big">{b.big}</p>
              <p class="badge__text" set:html={br(b.text)}></p>
              <p class="badge__note">{b.note}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="wordmark" aria-hidden="true">
        <span class="wordmark__text">GE<span class="wordmark__o">O<span class="wordmark__shape"><img src={url('/assets/shape-flower.png')} alt="" width="648" height="642" fetchpriority="high" class="float"></span></span>GLYF</span>
      </div>
      <a class="flood__tg" href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener" aria-label="Написать в Telegram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
      </a>
    </div>
  </section>

  <!-- Founder statement and numbers -->
  <section class="founder">
    <div class="founder__person">
      <img src={url('/assets/portrait.jpg')} alt="Георгий Шустов" width="669" height="667" loading="lazy">
      <p><strong>Гео Шустов</strong><br>Арт-директор и founder GEOGLYF</p>
    </div>
    <p class="founder__quote">Беру на себя путь от брифа и смыслов до дизайна и запуска, чтобы вы занимались бизнесом и принимали решения, а не управляли пятью подрядчиками.</p>
  </section>

  <section class="stats" aria-label="Цифры">
    {stats.map((s) => (
      <div class="stat">
        <p class="stat__big">{s.big}</p>
        <p class="stat__text" set:html={br(s.text)}></p>
      </div>
    ))}
  </section>

  <Clients />

  <!-- Objections + principle -->
  <section class="principle">
    <div class="principle__left">
      <h2 class="h2 h2--xl">Вам не нужен ещё один исполнитель. Вам нужен дизайнер, который доведёт <em>до результата</em></h2>
      <div class="objections" data-slider>
        <span class="objections__mark" aria-hidden="true">“</span>
        <div class="objections__stage" aria-live="polite">
          {objections.map((o, i) => (
            <div class="objection" data-slide hidden={i !== 0}>
              <p class="objection__q">«{o.q}»</p>
              <p class="objection__a">{o.a}</p>
            </div>
          ))}
        </div>
        <div class="objections__dots" role="tablist" aria-label="Частые опасения">
          {objections.map((o, i) => (
            <button type="button" role="tab" data-dot aria-selected={i === 0 ? 'true' : 'false'} aria-label={o.q}></button>
          ))}
        </div>
      </div>
    </div>
    <div class="principle__card">
      <p class="principle__label">Мой принцип:</p>
      <p class="principle__big">С вас задачи и решения.<br>С меня всё остальное</p>
      <p class="principle__small">Не прошу заполнять бриф на десять страниц. Задаю вопросы сам и собираю ответы на созвоне.</p>
      <p class="principle__label principle__label--mt">Ваше участие только в ключевых точках</p>
      <ol class="principle__steps">
        {participation.map((p, i) => (
          <li class:list={{ 'is-dark': i === 0 }}><span>{p.n}</span><span set:html={br(p.text)}></span></li>
        ))}
      </ol>
      <p class="principle__small">Не нужно писать ТЗ, искать фото или координировать разработчиков. Ваша задача делиться знанием о бизнесе и вовремя принимать решения.</p>
    </div>
  </section>

  <!-- Services as columns with price chips -->
  <section class="pricecols" id="prices">
    <h2 class="h2 h2--xl">Проекты под ключ <em>и поддержка</em></h2>
    <div class="pricecols__grid">
      {priceGroups.map((g) => (
        <div class="pricecol">
          <a class="pricecol__title" href={url(g.href)}>{g.title}</a>
          <ul class="pricecol__list">
            {g.items.map((it) => (
              <li><a href={url(it.href)}><span class="chip">{it.label}</span><span class="pricecol__price">{it.price}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="note">Если после консультации решаете работать со мной, её стоимость вычитается из проекта. <a href={url('/services/')}>Все услуги и что в них входит</a></p>
  </section>

  <!-- One contractor instead of five -->
  <section class="contractor">
    <h2 class="h2">Один подрядчик <em>вместо пяти</em></h2>
    <p class="lead">Обычно задача не «купить дизайн». Задача выйти к клиентам с сильной упаковкой и не развалить проект по дороге. Поэтому весь путь веду сам, а партнёров подключаю под своим арт-дирекшном.</p>
    <div class="contractor__grid">
      {contractorCards.map((c) => (
        <article class="ccard">
          <img src={url('/assets/' + c.shape)} alt="" width="400" height="400" loading="lazy" class="ccard__shape">
          <h3 class="ccard__title" set:html={br(c.title)}></h3>
          <p class="ccard__text">{c.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="work work--home" id="work">
    <h2 class="h2 h2--offset">Дизайн как часть <em>стратегии бизнеса</em></h2>
    <div class="work__grid">
      {cases.map((c) => <CaseCard item={c} />)}
    </div>
    <div class="more">
      <p class="more__title">Больше проектов<br>в портфолио</p>
      <a class="btn btn--soft btn--block" href={url('/work/')}>Все проекты</a>
    </div>
  </section>

  <!-- How I think + claims backed by facts -->
  <section class="mind">
    <div class="mind__card">
      <h2 class="h2 h2--xl">Что должно произойти в голове клиента, чтобы он <em>выбрал вас?</em></h2>
      <p class="lead">Этот вопрос определяет оффер, порядок блоков, тон, визуал и даже то, сколько текста нужно на странице.</p>
      <div class="mind__grid">
        {mindset.map((m) => (
          <div>
            <p class="mind__tag">{m.tag}</p>
            <h3 class="mind__title" set:html={br(m.title)}></h3>
            <p class="mind__text">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="claims">
      <h2 class="h2 h2--xl">Поэтому каждое обещание <em>подкрепляю фактом</em></h2>
      <div class="claims__grid">
        {claims.map((c) => (
          <div class="claim">
            <span class="claim__chip">Обещание</span>
            <h3 class="claim__title" set:html={br(c.claim)}></h3>
            <span class="claim__chip claim__chip--dark">Факт</span>
            <p class="claim__text">{c.proof}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Week-by-week plan -->
  <section class="plan">
    <Timeline
      title="Каждый этап <em>на своём месте</em>"
      text="Так выглядит типичный сайт на восемь недель. Сроки фиксируются в договоре. Если что-то сдвигается, вы узнаёте об этом в пятничном отчёте, а не в день сдачи."
      weeks={timeline.weeks}
      bars={timeline.bars} />
  </section>

  <!-- Promo: support format -->
  <section class="promo">
    <div class="promo__card">
      <a class="promo__mini" href={url('/support/#packs')}>
        <span class="promo__mini-big">2-3</span>
        <span>задачи в неделю на пакете «Лайт»</span>
        <span class="promo__mini-link">посмотреть пакеты</span>
      </a>
      <div class="promo__main">
        <p class="promo__pre">Когда задачи идут потоком,<br>есть формат:</p>
        <p class="promo__big">дизайн-<br>поддержка</p>
        <ul class="promo__tokens">
          <li><b>1</b><span>неделя спринт</span></li>
          <li><b>2 500</b><span>₽ в час</span></li>
          <li><b>0</b><span>₽ за простой</span></li>
        </ul>
        <a class="btn btn--accent btn--block" href={url('/support/')}>Подробнее</a>
      </div>
      <img src={url('/assets/shape-sparks.png')} alt="" width="845" height="900" loading="lazy" class="promo__shape float" aria-hidden="true">
    </div>
  </section>

  <ContactSection />
</Base>
