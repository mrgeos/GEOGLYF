---
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import { cases } from '../data/cases';
import { site } from '../data/site';
import { trust, featured, formats, process, facts } from '../data/home';
import { url } from '../lib/url';

const featuredCases = featured.map((f) => ({ ...f, c: cases.find((c) => c.slug === f.slug)! }));
const heroCase = featuredCases[0];
---
<Base
  title="GEOGLYF. Брендинг, сайты и дизайн-поддержка бизнеса"
  description="Гео Шустов, дизайнер и арт-директор. Айдентика, сайты и интерфейсы от идеи до запуска. Отдельный проект или регулярная поддержка команды.">

  <!-- 1. Offer + a real project fragment -->
  <section class="flood">
    <div class="flood__inner">
      <div class="flood__top">
        <div class="flood__text">
          <h1 class="flood__title">Брендинг, сайты и дизайн-поддержка бизнеса</h1>
          <p class="flood__lead">Я Гео Шустов, дизайнер и арт-директор. Создаю айдентику, сайты и интерфейсы от первых идей до запуска. Подключаюсь к отдельному проекту или к регулярным задачам команды.</p>
          <div class="flood__actions">
            <a class="btn btn--dark btn--block" href={url(site.cta.href)}>{site.cta.label}</a>
            <a class="btn btn--outline btn--block" href="#work">Смотреть проекты</a>
          </div>
        </div>
        <a class="flood__case" href={url(`/work/${heroCase.c.slug}/`)}>
          <!-- TODO: заменить на реальный фрагмент проекта (экран сайта, носитель бренда) -->
          <img src={heroCase.c.cover} alt={`Фрагмент проекта ${heroCase.c.name}`} width="1200" height="1200" fetchpriority="high">
          <span class="flood__case-cap"><b>{heroCase.c.name}</b> {heroCase.role}</span>
        </a>
      </div>
      <div class="wordmark" aria-hidden="true">
        <span class="wordmark__text">GE<span class="wordmark__o">O<span class="wordmark__shape"><img src={url('/assets/shape-flower.png')} alt="" width="648" height="642" class="float"></span></span>GLYF</span>
      </div>
    </div>
  </section>

  <!-- 2. Compact trust line -->
  <section class="trust" aria-label="Опыт">
    <p class="trust__lead">{trust.lead}</p>
    <ul class="trust__list">
      {trust.items.map((t) => <li><b>{t.who}</b><span>{t.what}</span></li>)}
    </ul>
  </section>

  <!-- 3. Three featured cases -->
  <section class="featured" id="work">
    <h2 class="h2 h2--xl">Избранные <em>проекты</em></h2>
    <div class="featured__list">
      {featuredCases.map(({ c, role, task }, i) => (
        <a class:list={['fcase', { 'fcase--big': i === 0 }]} href={url(`/work/${c.slug}/`)}>
          <span class="fcase__media">
            <!-- TODO: реальная обложка проекта -->
            <img src={c.cover} alt={`Обложка проекта ${c.name}`} width="1600" height="1200" loading="lazy">
          </span>
          <span class="fcase__body">
            <span class="fcase__name">{c.name}</span>
            <span class="fcase__row"><span class="fcase__label">Задача</span>{task}</span>
            <span class="fcase__row"><span class="fcase__label">Моя роль</span>{role}</span>
            <span class="fcase__more">Смотреть кейс</span>
          </span>
        </a>
      ))}
    </div>
    <a class="btn btn--soft btn--block featured__all" href={url('/work/')}>Все проекты</a>
  </section>

  <!-- 4. Two formats -->
  <section class="formats" id="prices">
    <h2 class="h2 h2--xl">Два формата <em>работы</em></h2>
    <div class="formats__grid">
      {formats.map((f) => (
        <article class:list={['format', `format--${f.tone}`]}>
          <h3 class="format__title">{f.title}</h3>
          <p class="format__for"><span class="format__label">Кому подходит</span>{f.forWhom}</p>
          <p class="format__label">Что вы получаете</p>
          <ul class="format__list">{f.gets.map((g) => <li>{g}</li>)}</ul>
          <p class="format__price">{f.price}<span>{f.priceNote}</span></p>
          <a class:list={['btn', f.tone === 'dark' ? 'btn--accent' : 'btn--dark']} href={url(f.href)}>{f.cta}</a>
        </article>
      ))}
    </div>
    <p class="note">Если после консультации за 15 000 ₽ решаете работать со мной, её стоимость вычитается из проекта. <a href={url('/services/')}>Все услуги и цены</a></p>
  </section>

  <!-- 5. How the work goes -->
  <section class="flow">
    <h2 class="h2 h2--xl">Как проходит <em>работа</em></h2>
    <ol class="flow__list">
      {process.map((p, i) => (
        <li class="flow__step">
          <span class="flow__n">{i + 1}</span>
          <h3 class="flow__title">{p.title}</h3>
          <p class="flow__text">{p.text}</p>
          <p class="flow__you"><span>Ваше участие</span>{p.you}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 6. About + proof -->
  <section class="me">
    <div class="me__photo">
      <img src={url('/assets/portrait.jpg')} alt="Георгий Шустов" width="669" height="667" loading="lazy">
      <img class="me__shape float" src={url('/assets/shape-star-outline.png')} alt="" width="1130" height="1053" loading="lazy" aria-hidden="true">
    </div>
    <div class="me__text">
      <h2 class="h2">Гео Шустов. <em>Арт-директор &amp; founder</em></h2>
      <p class="lead">Начинал как веб-дизайнер и верстальщик, поэтому не рисую того, что нельзя собрать. Десять лет руководил дизайном в движении ЭКА, как founding designer запускал ПосадиЛес и Ecowiki.ru. Сейчас работаю под маркой GEOGLYF: сам и с проверенными партнёрами по разработке.</p>
      <dl class="me__facts">
        {facts.map((f) => <div><dt>{f.big}</dt><dd>{f.text}</dd></div>)}
      </dl>
      <!-- TODO: блок отзывов. Добавить 2-3 реальные цитаты клиентов (текст, имя, компания). -->
      <a class="link-arrow" href={url('/about/')}>Подробнее обо мне</a>
    </div>
  </section>

  <!-- 7. Contact -->
  <ContactSection />
</Base>
