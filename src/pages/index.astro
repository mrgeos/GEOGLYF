---
import Base from '../layouts/Base.astro';
import Clients from '../components/Clients.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { services } from '../data/services';
import { cases } from '../data/cases';
import { site } from '../data/site';
import { url } from '../lib/url';
---
<Base
  title="GEOGLYF. Гео Шустов. Дизайн-поддержка бизнеса и проектный дизайн"
  description="Мультидисциплинарный дизайнер и арт-директор Георгий Шустов. Дизайн-поддержка по Time & Material, брендинг, айдентика, сайты, лендинги, UI/UX и key visual. 20 лет в индустрии, 650+ проектов.">

  <section class="hero">
    <div class="hero__text">
      <h1 class="hero__title">
        Дизайнер<br>
        на расстоянии<br>
        <em>одного сообщения</em>
      </h1>
      <p class="hero__lead">Веду дизайн вашего бренда каждую неделю или делаю проект под ключ: айдентика, сайт, интерфейс, key visual.</p>
      <div class="hero__actions">
        <a class="btn btn--accent" href={url(site.cta.href)}>{site.cta.label}</a>
        <a class="btn btn--ghost" href={url('/work/')}>Смотреть проекты</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <img class="hero__flower float" src={url('/assets/shape-flower.png')} alt="" width="648" height="642" fetchpriority="high">
      <img class="hero__spark float float--slow" src={url('/assets/shape-spark.png')} alt="" width="1033" height="1302">
    </div>
  </section>

  <Clients />

  <section class="support" id="support">
    <div class="support__head">
      <h2 class="h2">Поддержка. <em>Дизайнер в команде</em> без найма в штат</h2>
      <p class="lead">Формат Time&nbsp;&amp;&nbsp;Material: работаем недельными спринтами, платите только за фактические часы. Баннеры, презентации, правки на сайте, соцсети, печать. Всё, что нужно бренду каждую неделю.</p>
    </div>
    <div class="support__grid">
      <article class="tile tile--accent">
        <p class="tile__big">{site.rate}<span>/час</span></p>
        <p>Единая ставка на любые задачи: от баннера до дизайн-системы. Оценка каждой задачи до старта.</p>
      </article>
      <article class="tile tile--dark">
        <p class="tile__big">min&nbsp;-&nbsp;max</p>
        <p>Бюджет месяца фиксируем вилкой. Итог никогда не превышает max без вашего письменного согласия.</p>
      </article>
      <article class="tile tile--image">
        <img src={url('/assets/shape-ring.png')} alt="" width="823" height="589" loading="lazy">
      </article>
      <article class="tile">
        <h3 class="h4">Что входит</h3>
        <ul class="list">
          <li>Баннеры, соцсети, рассылки</li>
          <li>Презентации и коммерческие предложения</li>
          <li>Правки и новые страницы сайта</li>
          <li>Печать, мерч, полиграфия</li>
          <li>Иллюстрации, 3D, ИИ-генерации</li>
          <li>Арт-дирекшн подрядчиков</li>
        </ul>
      </article>
      <article class="tile">
        <h3 class="h4">Как начать</h3>
        <ol class="list list--num">
          <li>Знакомимся, смотрю ваши материалы</li>
          <li>Определяем вилку часов на месяц</li>
          <li>Подписываем рамочный договор</li>
          <li>Первый спринт стартует в понедельник</li>
        </ol>
        <a class="link-arrow" href={url('/support/')}>Подробнее о поддержке</a>
      </article>
    </div>
  </section>

  <section class="services" id="services">
    <h2 class="h2">Проектные услуги <em>под ключ</em></h2>
    <p class="lead">Когда нужен результат с чётким объёмом, сроком и стоимостью. Фиксированная смета по договору, оплата по этапам, гарантия 12 месяцев.</p>
    <div class="services__list">
      {services.map((s) => (
        <a class="svc-row" href={url(`/services/${s.slug}/`)}>
          <span class="svc__name">{s.name}</span>
          <span class="svc__meta">{s.duration}</span>
        </a>
      ))}
    </div>
    <div class="services__visual" aria-hidden="true">
      <img src={url('/assets/shape-swirl.png')} alt="" width="1107" height="1113" loading="lazy" class="float">
    </div>
  </section>

  <section class="work" id="work">
    <h2 class="h2">Проекты</h2>
    <div class="work__grid">
      {cases.map((c) => <CaseCard item={c} />)}
    </div>
    <a class="link-arrow" href={url('/work/')}>Все проекты</a>
  </section>

  <section class="about" id="about">
    <div class="about__photo">
      <img src={url('/assets/portrait.jpg')} alt="Георгий Шустов" width="669" height="667" loading="lazy">
      <img class="about__star float" src={url('/assets/shape-star-outline.png')} alt="" width="1130" height="1053" loading="lazy" aria-hidden="true">
    </div>
    <div class="about__text">
      <h2 class="h2">Гео Шустов. Арт-директор <em>&amp; founder</em></h2>
      <p class="lead">Соединяю дизайн и маркетинг: понимаю не только как должно выглядеть, но и как должно работать на узнаваемость, доверие и продажи.</p>
      <dl class="facts">
        <div><dt>20</dt><dd>лет в дизайне и разработке сайтов</dd></div>
        <div><dt>650+</dt><dd>реализованных проектов</dd></div>
        <div><dt>10</dt><dd>лет арт-директор экодвижения ЭКА</dd></div>
        <div><dt>ECO, HoReCa, ED, Event</dt><dd>отрасли, в которых работаю чаще всего</dd></div>
      </dl>
      <a class="link-arrow" href={url('/about/')}>Подробнее обо мне</a>
    </div>
  </section>

  <ContactSection />
</Base>
